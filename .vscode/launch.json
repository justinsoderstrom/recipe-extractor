{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build API",
      "program": "${workspaceFolder}/src/api/bin/Debug/net10.0/RecipeExtractor.Api.dll",
      "cwd": "${workspaceFolder}/src/api",
      "launchSettingsProfile": "http",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "Web (Vite + browser)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/src/web",
      "console": "internalConsole",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "env": { "NO_COLOR": "1" },
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}/src/web",
        "killOnServerStop": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Recipe Extractor",
      "configurations": ["API", "Web (Vite + browser)"],
      "stopAll": true
    }
  ]
}
